# Copy to .env and fill in. install.sh reads this file too.
#
# Snippy loads this itself on startup, so the systemd unit and
# scripts/run-daemon.sh do not need to export anything.

# Required. Bot token from the Discord Developer Portal.
# See README.md, Part 1.
DISCORD_TOKEN=your-bot-token-here

# Your server ID. Registering commands in one server makes them appear in
# about a second; a global registration can take up to an hour.
# Right-click the server in Discord -> Copy Server ID.
# Delete this line to register commands globally instead.
DISCORD_GUILD_ID=

# Optional. Where the SQLite database and clip archive live.
SNIPPY_DATA_DIR=./data

# Optional. Baseline config every server inherits; per-server changes made
# with /snippy config are stored in SQLite and override this.
SNIPPY_CONFIG=./config/default.toml

# Optional. DEBUG, INFO, WARNING, or ERROR.
SNIPPY_LOG_LEVEL=INFO

# The archive disk ceiling is a per-server setting, not an environment
# variable: /snippy config archive, or archive.quota_mb in
# config/default.toml.